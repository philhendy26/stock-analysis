import yfinance as yf
import pandas as pd
import numpy as np
import plotly.graph_objects as go
from plotly.subplots import make_subplots
from datetime import datetime, timedelta
from prophet import Prophet
from sklearn.metrics import mean_absolute_error, mean_squared_error
import warnings
warnings.filterwarnings('ignore')

# ============================
# 1. Define FAANG Tickers & Fetch Data
# ============================

tickers = ['META', 'AAPL', 'AMZN', 'NFLX', 'GOOGL']
faang_names = {'META': 'Meta', 'AAPL': 'Apple', 'AMZN': 'Amazon', 'NFLX': 'Netflix', 'GOOGL': 'Alphabet'}

print("📥 Downloading 10-year historical data...")
data = {}
for ticker in tickers:
    data[ticker] = yf.download(ticker, period="10y", interval="1d")['Adj Close']

df = pd.DataFrame(data)
df.index = pd.to_datetime(df.index)

# Current Prices (as of latest close)
current_prices = df.iloc[-1]
print("\nCurrent Prices (May 2026):")
print(current_prices.round(2))

# ============================
# 2. Performance Analysis (10-Year History)
# ============================

returns = df.pct_change().dropna()
cum_returns = (1 + returns).cumprod() - 1
annualized_returns = returns.mean() * 252
annualized_vol = returns.std() * np.sqrt(252)
sharpe_ratio = annualized_returns / annualized_vol

perf_df = pd.DataFrame({
    'Current Price': current_prices.round(2),
    '10Y Total Return (%)': (cum_returns.iloc[-1] * 100).round(1),
    'Annualized Return (%)': (annualized_returns * 100).round(2),
    'Annualized Vol (%)': (annualized_vol * 100).round(2),
    'Sharpe Ratio': sharpe_ratio.round(2)
})

print("\n=== 10-Year Performance Summary ===")
print(perf_df)

# ============================
# 3. Prophet Forecasting (Latest Time-Series ML Technique)
# ============================

def forecast_stock(ticker, years=5):
    stock_data = df[[ticker]].reset_index()
    stock_data.columns = ['ds', 'y']
    
    model = Prophet(
        yearly_seasonality=True,
        weekly_seasonality=False,
        daily_seasonality=False,
        seasonality_mode='multiplicative',
        changepoint_prior_scale=0.05,   # Flexible trend
        interval_width=0.95
    )
    model.fit(stock_data)
    
    future = model.make_future_dataframe(periods=years*365)
    forecast = model.predict(future)
    
    return forecast, model

print("\n🔮 Running 5-Year Forecasts using Prophet...")
forecasts = {}
for ticker in tickers:
    forecast, model = forecast_stock(ticker)
    forecasts[ticker] = forecast
    final_price = forecast['yhat'].iloc[-1]
    cagr = ((final_price / current_prices[ticker]) ** (1/5) - 1) * 100
    print(f"{faang_names[ticker]:8} → Forecast 2031 Price: ${final_price:,.2f} | Expected CAGR: {cagr:.1f}%")

# ============================
# 4. Visualizations
# ============================

fig = make_subplots(
    rows=2, cols=2,
    subplot_titles=("10Y Cumulative Returns", "5Y Price Forecasts", 
                    "Annualized Returns vs Volatility", "Current Allocation Suggestion"),
    specs=[[{"type": "scatter"}, {"type": "scatter"}],
           [{"type": "scatter"}, {"type": "pie"}]]
)

colors = ['blue', 'green', 'orange', 'red', 'purple']

# 10Y Cumulative Returns
for i, ticker in enumerate(tickers):
    fig.add_trace(go.Scatter(x=cum_returns.index, y=cum_returns[ticker]*100, 
                           name=faang_names[ticker], line=dict(color=colors[i])), row=1, col=1)

# 5Y Forecasts (last 2 years actual + forecast)
for i, ticker in enumerate(tickers):
    hist = df[ticker].tail(500)
    fcast = forecasts[ticker].tail(365*5 + 100)
    fig.add_trace(go.Scatter(x=hist.index, y=hist, name=f"{faang_names[ticker]} Actual", 
                           line=dict(color=colors[i])), row=1, col=2)
    fig.add_trace(go.Scatter(x=fcast['ds'], y=fcast['yhat'], name=f"{faang_names[ticker]} Forecast", 
                           line=dict(dash='dash', color=colors[i])), row=1, col=2)

# Return vs Volatility
fig.add_trace(go.Scatter(
    x=perf_df['Annualized Vol (%)'],
    y=perf_df['Annualized Return (%)'],
    mode='markers+text',
    text=list(faang_names.values()),
    marker=dict(size=12, color=colors)
), row=2, col=1)

# Portfolio Suggestion (equal weight for simplicity)
fig.add_trace(go.Pie(
    labels=list(faang_names.values()),
    values=[20]*5,
    hole=0.4
), row=2, col=2)

fig.update_layout(height=900, title_text="FAANG Stocks - 10Y Analysis & 5Y ML Forecast (May 2026)")
fig.show()

# ============================
# 5. Final Recommendation
# ============================

# Simple scoring: High return, lower vol, strong forecast CAGR
perf_df['Forecast_CAGR'] = [((forecasts[t]['yhat'].iloc[-1] / current_prices[t]) ** (1/5) - 1) * 100 for t in tickers]
perf_df['Score'] = perf_df['Annualized Return (%)'] * 0.4 + perf_df['Forecast_CAGR'] * 0.4 - perf_df['Annualized Vol (%)'] * 0.2

best_stock = perf_df['Score'].idxmax()
print("\n" + "="*60)
print(f"🏆 RECOMMENDED STOCK FOR NEXT 5-10 YEARS: **{faang_names[best_stock]} ({best_stock})**")
print("="*60)
print("Rationale: Highest combined historical performance, forecasted growth, and risk-adjusted score.")

print("\nFull Ranking by Score:")
print(perf_df[['Annualized Return (%)', 'Forecast_CAGR', 'Score']].sort_values('Score', ascending=False).round(2))

